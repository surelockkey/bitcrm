<div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 12"><div class="blk blk-itemsTable"><table class="items striped"><thead><tr style="background:#111827;color:#ffffff"><th class="col-name">Item</th><th class="col-quantity num">Qty</th><th class="col-unitPrice num">Price</th><th class="col-amount num">Amount</th></tr></thead><tbody><tr><td class="col-name"><div class="item-name">Rekey lock cylinder</div><div class="item-desc">Rekey existing cylinders to a new key, 2 keys included</div></td><td class="col-quantity num">4</td><td class="col-unitPrice num">$35.00</td><td class="col-amount num">$140.00</td></tr><tr><td class="col-name"><div class="item-name">Schlage B60N deadbolt</div><div class="item-desc">Grade 1 single-cylinder deadbolt, satin nickel</div></td><td class="col-quantity num">2</td><td class="col-unitPrice num">$89.00</td><td class="col-amount num">$178.00</td></tr><tr><td class="col-name"><div class="item-name">Emergency service call</div><div class="item-desc">After-hours dispatch fee</div></td><td class="col-quantity num">1</td><td class="col-unitPrice num">$125.00</td><td class="col-amount num">$125.00</td></tr><tr><td class="col-name"><div class="item-name">Key duplication</div><div class="item-desc">Standard KW1/SC1 key copies</div></td><td class="col-quantity num">6</td><td class="col-unitPrice num">$4.50</td><td class="col-amount num">$27.00</td></tr></tbody></table></div></div></div>
