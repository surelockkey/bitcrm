<body>
<table class="doc-layout">
<thead><tr><td><div class="doc-header" data-section="header"><div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 6;align-self:center"></div><div class="col" style="grid-column:span 6"><div class="blk blk-text" style="text-align:right;font-size:9px"><div class="rt"><h3>SureLock Key Services</h3><p>120 Main St, Hartford, CT 06103</p><p>(860) 555-0142</p><p>office@surelockkey.com</p><p>www.surelockkey.com</p><p>LCK.0001234</p></div></div></div></div>
<div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 12"><div class="blk blk-divider" style="color:#1e3a8a"><hr style="border-top:2px solid #1e3a8a"></div></div></div></div></td></tr></thead>
<tfoot><tr><td><div class="doc-footer" data-section="footer"><div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 12"><div class="blk blk-divider"><hr style="border-top:1px solid var(--border)"></div><div class="blk blk-text" style="text-align:center;color:#6b7280;font-size:8px"><div class="rt"><p><strong>Thank you for your business!</strong></p><p>SureLock Key Services · (860) 555-0142 · www.surelockkey.com</p><p>Estimate #1042-1 · Sep 12, 2026</p></div></div></div></div></div></td></tr></tfoot>
<tbody><tr><td><div class="doc-body" data-section="body"><div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 7"><div class="blk blk-text" style="color:#1e3a8a"><div class="rt"><h1>ESTIMATE</h1><p>Option A – High-security upgrade</p></div></div></div><div class="col" style="grid-column:span 5"><div class="blk blk-field"><div class="field"><span class="field-label">Estimate #</span><span class="field-value">1042-1</span></div></div><div class="blk blk-field"><div class="field"><span class="field-label">Date</span><span class="field-value">Sep 12, 2026</span></div></div><div class="blk blk-field"><div class="field"><span class="field-label">Status</span><span class="field-value">Pending</span></div></div><div class="blk blk-field"><div class="field"><span class="field-label">Job #</span><span class="field-value">1042</span></div></div><div class="blk blk-field"><div class="field"><span class="field-label">PO #</span><span class="field-value">PO-7781</span></div></div></div></div>
<div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 12"><div class="blk blk-spacer"><div style="height:12px"></div></div></div></div>
<div class="row" style="column-gap:24px"><div class="col" style="grid-column:span 6"><div class="blk blk-text"><div class="rt"><p><span style="color:#1e3a8a"><strong>BILL TO</strong></span></p><p><strong>Emily Carter</strong></p><p>Carter Dental Group</p><p>PO Box 311, West Hartford, CT 06127</p><p>(860) 555-0199</p><p>emily.carter@example.com</p></div></div></div><div class="col" style="grid-column:span 6"><div class="blk blk-text"><div class="rt"><p><span style="color:#1e3a8a"><strong>SERVICE ADDRESS</strong></span></p><p>45 Oak Ave, West Hartford, CT 06107</p><p>Job type: Rekey &amp; lock upgrade</p><p>Technician: Mike Rivera</p><p>Scheduled: Sep 12, 2026 10:00 AM</p></div></div></div></div>
<div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 12"><div class="blk blk-spacer"><div style="height:16px"></div></div></div></div>
<div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 12"><div class="blk blk-itemsTable"><table class="items striped"><thead><tr style="background:#1e3a8a;color:#ffffff"><th class="col-name">Item</th><th class="col-quantity num">Qty</th><th class="col-unitPrice num">Price</th><th class="col-amount num">Amount</th></tr></thead><tbody><tr><td class="col-name"><div class="item-name">Rekey lock cylinder</div><div class="item-desc">Rekey existing cylinders to a new key, 2 keys included</div></td><td class="col-quantity num">4</td><td class="col-unitPrice num">$35.00</td><td class="col-amount num">$140.00</td></tr><tr><td class="col-name"><div class="item-name">Schlage B60N deadbolt</div><div class="item-desc">Grade 1 single-cylinder deadbolt, satin nickel</div></td><td class="col-quantity num">2</td><td class="col-unitPrice num">$89.00</td><td class="col-amount num">$178.00</td></tr><tr><td class="col-name"><div class="item-name">Emergency service call</div><div class="item-desc">After-hours dispatch fee</div></td><td class="col-quantity num">1</td><td class="col-unitPrice num">$125.00</td><td class="col-amount num">$125.00</td></tr><tr><td class="col-name"><div class="item-name">Key duplication</div><div class="item-desc">Standard KW1/SC1 key copies</div></td><td class="col-quantity num">6</td><td class="col-unitPrice num">$4.50</td><td class="col-amount num">$27.00</td></tr></tbody></table></div></div></div>
<div class="row" style="column-gap:24px;padding-top:12px"><div class="col" style="grid-column:span 6"><div class="blk blk-notes"><div class="notes-title">Notes</div><div class="notes-body">Gate code 4471. Please call on arrival.<br>All hardware carries a 1-year warranty.</div></div></div><div class="col" style="grid-column:span 6"><div class="blk blk-totals"><table class="totals"><tbody><tr class="t-subtotal"><td class="t-label">Subtotal</td><td class="t-value">$470.00</td></tr><tr class="t-discount"><td class="t-label">Discount</td><td class="t-value">-$25.00</td></tr><tr class="t-tax"><td class="t-label">Tax (CT Sales Tax 6.35%)</td><td class="t-value">$20.74</td></tr><tr class="t-total"><td class="t-label">Estimate total</td><td class="t-value">$465.74</td></tr></tbody></table></div></div></div>
<div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 12"><div class="blk blk-spacer"><div style="height:16px"></div></div></div></div>
<div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 12"><div class="blk blk-text" style="font-size:9px"><div class="rt"><p><span style="color:#1e3a8a"><strong>Terms &amp; conditions</strong></span></p><p>This estimate is valid for 30 days from Sep 12, 2026. Prices include labor and the listed hardware; additional work will be quoted before it is performed. Sign below to approve.</p></div></div></div></div>
<div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 12"><div class="blk blk-spacer"><div style="height:16px"></div></div></div></div>
<div class="row" style="column-gap:16px"><div class="col" style="grid-column:span 6"><div class="blk blk-signature"><div class="sig"><div class="sig-line"></div><div class="sig-meta"><span class="sig-label">Client approval</span></div><div class="sig-date">Date: <span class="date-line"></span></div></div></div></div><div class="col" style="grid-column:span 6"></div></div></div></td></tr></tbody>
</table>
</body>
</html>
"
`;

