# Base URL for the BitCRM API gateway (nginx locally / ALB in prod).
# All requests go to `${NEXT_PUBLIC_API_BASE_URL}/{users,crm,deals,inventory}/...`.
# Public docs live at https://api.bitcrm.tech-slk.com/api/docs
NEXT_PUBLIC_API_BASE_URL=https://api.bitcrm.tech-slk.com/api

# Browser key for Google Maps: Places API (address autocomplete) + Maps JavaScript
# API (the /dispatch map). Visible in the client bundle — restrict it by HTTP
# referrer in Google Cloud Console. Server-side geocoding uses a separate,
# IP-restricted GOOGLE_MAPS_API_KEY on the backend. Optional: without it, address
# fields fall back to manual entry and /dispatch explains itself.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID from Google Cloud Console -> Map management. Must be JavaScript + **Vector**:
# job pins use AdvancedMarker, which silently draws nothing without a vector Map ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Local development only: proxy /api/* straight to the services on 4001-4006,
# skipping the Docker gateway. Docker Desktop's macOS port forwarding drops a
# large share of connections to host.docker.internal, which looks exactly like
# the backend going down. Requires NEXT_PUBLIC_API_BASE_URL=/api.
# API_DIRECT=1
