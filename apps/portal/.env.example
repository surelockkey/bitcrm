# Base URL of the BitCRM API. The portal calls ${base}/billing/public/portal/<token>/… — the
# unauthenticated, token-gated routes; there is no sign-in and no staff session on this app.
#   AWS:     https://api.bitcrm.tech-slk.com/api
#   Local:   http://localhost:4000/api  (gateway)  or  http://localhost:4008/api  (billing directly)
NEXT_PUBLIC_API_BASE_URL=https://api.bitcrm.tech-slk.com/api

# Optional. The Stripe publishable key normally comes back with the payment session, so the
# portal needs no Stripe configuration; set this only to pin the key at build time instead.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
