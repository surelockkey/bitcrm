# Base URL of the BitCRM API gateway.
# Expo inlines EXPO_PUBLIC_* vars into the app bundle at build time.
#
# Unset, the app talks to the shared dev gateway (see src/lib/env.ts):
#   https://api.bitcrm.tech-slk.com/api
#
# To point a build at a laptop instead, give the host — the `/api` prefix that
# every service lives under is added for you, and a trailing slash is ignored:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:4000
#
# Use the machine's LAN IP, not localhost: on a phone, localhost is the phone.
EXPO_PUBLIC_API_BASE_URL=https://api.bitcrm.tech-slk.com/api
