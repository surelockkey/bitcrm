{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testRegex": "test/e2e/.*\\.e2e\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "diagnostics": { "warnOnly": true } }]
  },
  "moduleNameMapper": { "^src/(.*)$": "<rootDir>/src/$1" },
  "testEnvironment": "node",
  "testTimeout": 120000,
  "maxWorkers": 1,
  "setupFiles": ["<rootDir>/test/e2e/env.ts"]
}
