{
  "uid": "bitcrm-telephony",
  "title": "BitCRM - Telephony",
  "tags": ["bitcrm", "telephony"],
  "timezone": "browser",
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Calls Answered (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(increase(bitcrm_calls_answered_total[1h]))",
          "legendFormat": "answered"
        }
      ]
    },
    {
      "id": 2,
      "title": "Calls Completed (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(increase(bitcrm_calls_completed_total[1h]))",
          "legendFormat": "completed"
        }
      ]
    },
    {
      "id": 3,
      "title": "Failed / Busy / Canceled (%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(bitcrm_calls_completed_total{status=~\"failed|busy|canceled\"}[30m])) / clamp_min(sum(rate(bitcrm_calls_completed_total[30m])), 0.0001) * 100",
          "legendFormat": "failure %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Median Talk Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(bitcrm_call_duration_seconds_bucket[30m])) by (le))",
          "legendFormat": "P50"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "title": "Call Volume by Direction",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(bitcrm_calls_answered_total[5m])) by (direction)",
          "legendFormat": "answered {{direction}}"
        },
        {
          "expr": "sum(rate(bitcrm_calls_completed_total[5m])) by (direction)",
          "legendFormat": "completed {{direction}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Call Outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(bitcrm_calls_completed_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Talk Time Distribution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(bitcrm_call_duration_seconds_bucket[5m])) by (le, direction))",
          "legendFormat": "P50 {{direction}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(bitcrm_call_duration_seconds_bucket[5m])) by (le, direction))",
          "legendFormat": "P95 {{direction}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 8,
      "title": "Twilio Webhook Traffic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"telephony-service\"}[5m])) by (route, status_code)",
          "legendFormat": "{{route}} {{status_code}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "call-events Published",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(bitcrm_events_published_total{service=\"telephony-service\"}[5m])) by (event_type)",
          "legendFormat": "{{event_type}}"
        },
        {
          "expr": "sum(rate(bitcrm_events_failed_total{service=\"telephony-service\"}[5m])) by (event_type)",
          "legendFormat": "failed {{event_type}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Telephony Dependencies",
      "type": "state-timeline",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "min by (kind, name) (bitcrm_dependency_up{service=\"telephony-service\"})",
          "legendFormat": "{{kind}}/{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "down", "color": "red" },
                "1": { "text": "up", "color": "green" }
              }
            }
          ]
        }
      }
    }
  ]
}
