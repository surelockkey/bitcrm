# DynamoDB
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Redis
REDIS_URL=redis://localhost:6379

# Cognito (fill from terraform output)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Service ports
USER_SERVICE_PORT=4001
CRM_SERVICE_PORT=4002
DEAL_SERVICE_PORT=4003
INVENTORY_SERVICE_PORT=4004
SEARCH_SERVICE_PORT=4005
TELEPHONY_SERVICE_PORT=4006
MESSAGING_SERVICE_PORT=4007

# Internal service URLs (for service-to-service calls)
USER_SERVICE_URL=http://localhost:4001
CRM_SERVICE_URL=http://localhost:4002
DEAL_SERVICE_URL=http://localhost:4003
INVENTORY_SERVICE_URL=http://localhost:4004
SEARCH_SERVICE_URL=http://localhost:4005
TELEPHONY_SERVICE_URL=http://localhost:4006
MESSAGING_SERVICE_URL=http://localhost:4007

# LocalStack (SNS, SQS, S3 in local dev — omit in prod to use real AWS)
AWS_ENDPOINT=http://localhost:4566

# S3
S3_BUCKET=bitcrm-uploads

# OpenSearch (global-search read model)
OPENSEARCH_ENDPOINT=http://localhost:9200
# OPENSEARCH_SERVERLESS=true      # AWS OpenSearch Serverless — switches the client to SigV4
                                  # and disables the unsigned connectivity probe

# --- Observability (docker compose --profile monitoring) ---
# Traces → Tempo. Defaults to http://localhost:4318 when unset.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Logs → Loki. Unset leaves logs on stdout only; the shipper is opt-in so a
# service started without the monitoring stack behaves exactly as before.
LOKI_URL=http://localhost:3100
# Grafana Cloud's Loki is authenticated: username is the numeric instance id,
# password is the access-policy token. The local docker Loki has no auth, so
# leave both unset locally — sending an empty credential makes it reject the
# push. Both halves must be present or neither is sent.
# LOKI_USERNAME=
# LOKI_PASSWORD=

# --- Grafana Cloud (deployed environments only) ---
# Set in SSM under /bitcrm/dev/, which render-taskdef.sh maps to these names.
# None of these is secret; the token alone is, and it comes from the GitHub
# environment secret GRAFANA_CLOUD_TOKEN.
# PROM_REMOTE_WRITE_URL=https://prometheus-prod-<n>-<region>.grafana.net/api/prom/push
# PROM_USERNAME=<numeric prometheus instance id>
# OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTLP_USERNAME=<numeric STACK id — not the Tempo instance id>

# Internal service secret (for service-to-service HTTP calls)
INTERNAL_SERVICE_SECRET=

# Twilio telephony (browser softphone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=                 # OPTIONAL default caller id, E.164. Unset → falls back to the account's first owned number
# OPTIONAL fallback for legs the SYSTEM places (masked bridge, technician dial-in)
# when the job's service area has no number of its own. Sits above TWILIO_CALLER_ID
# in that chain only; the human dialer is unaffected.
TELEPHONY_DEFAULT_AREA_CALLER_ID=
PUBLIC_BASE_URL=                  # public URL Twilio can reach (ngrok in dev), scheme+host only, no trailing slash
# OPTIONAL Messaging Service (MG…) the workspace's numbers are pooled in. Read by
# every service that talks to Twilio (shared TwilioConfig): telephony reports
# which owned numbers are in it, messaging sends through it.
TWILIO_MESSAGING_SERVICE_SID=
CALL_EVENTS_TOPIC_ARN=            # OPTIONAL SNS topic for call.* events (unset → not published)
# TELEPHONY_DB_SETUP=false        # opt out of the automatic calls-table migration at boot
CALL_GROUPS_TABLE=BitCRM_CallGroups   # call-group settings; created by `npm run setup:dynamodb -w backend/services/telephony`
CALL_FLOWS_TABLE=BitCRM_CallFlows     # call-flow settings; same setup script

# --- Technician dial-in (masked calls from any handset) ---
# The shared technician line is NOT an env var — it is designated per number on
# Settings > Phone Numbers, so a workspace can only ever have one and changing
# it needs no redeploy.
# How long the technician's own handset rings on an in-app bridge. Twilio adds
# up to a 5s buffer, so 15 gives an effective ring of ~20s.
TELEPHONY_BRIDGE_RING_SECONDS=15
# How long a released job code stays unusable before it can be drawn again.
TELEPHONY_EXT_QUARANTINE_DAYS=90

# --- Messaging (SMS/MMS/email inbox — messaging-service) ---
# Shares TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / PUBLIC_BASE_URL with telephony:
# the webhook signature guard needs the token of the account that owns the numbers.
# In AWS every value below except the Twilio ones comes from SSM via render-taskdef.sh.
MESSAGING_TABLE=BitCRM_Messaging  # local table; created by `npm run setup:aws -w backend/services/messaging`
TWILIO_MESSAGING_SERVICE_SID=     # Messaging Service (MG…) every outbound SMS goes through — A2P 10DLC needs it
MESSAGING_DEFAULT_SENDER=         # OPTIONAL E.164 fallback sender when no stickier number applies to the conversation
MESSAGE_EVENTS_TOPIC_ARN=         # OPTIONAL SNS topic for message.* / conversation.updated / opt_out.changed (unset → not published)
MESSAGING_OUTBOUND_QUEUE_URL=     # SQS FIFO (…-messaging-outbound.fifo): accepted messages → send worker
MESSAGING_MEDIA_QUEUE_URL=        # SQS: inbound MMS media to copy into S3 messaging/<conv>/<msg>/<attachment>
CONTACT_EVENTS_TO_MESSAGING_QUEUE_URL=  # SQS: contact.merged / contact.updated from crm
# DOCUMENTS_BUCKET / DOCUMENTS_KMS_KEY_ID as for deal attachments (unset locally → S3_BUCKET, no KMS)
